@{
    ViewData["Title"] = "Home - Leaderboard";
}

<div class="container mt-4">
    <div class="text-center mb-4">
        <h1 class="display-4">🏆 Leaderboard</h1>
        <p class="lead">Top players by completion time</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Top 5 Fastest Players</h5>
                </div>
                <div class="card-body">
                    <div id="loading" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                        <p class="mt-2">Loading leaderboard...</p>
                    </div>
                    <div id="error" class="alert alert-danger d-none" role="alert"></div>
                    <div id="leaderboard-container" class="d-none">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 10%;">Rank</th>
                                        <th style="width: 50%;">Username</th>
                                        <th style="width: 30%;">Time (seconds)</th>
                                        <th style="width: 10%;" class="text-center">Premium</th>
                                    </tr>
                                </thead>
                                <tbody id="leaderboard-body">
                                    <!-- Populated by JavaScript -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">📡 API Documentation</h5>
                    <p class="card-text">Explore and test all available API endpoints</p>
                    <a href="/swagger" class="btn btn-success" target="_blank">Open Swagger UI</a>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h5 class="card-title">📖 Documentation</h5>
                    <p class="card-text">Learn about building Web apps with ASP.NET Core</p>
                    <a href="https://learn.microsoft.com/aspnet/core" class="btn btn-info" target="_blank">Learn More</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadLeaderboard();
        });

        function loadLeaderboard() {
            $.ajax({
                url: '/User/Leaderboard?limit=5',
                type: 'GET',
                success: function (response) {
                    if (response.success && response.leaderboard) {
                        displayLeaderboard(response.leaderboard);
                    } else {
                        showError('Failed to load leaderboard data');
                    }
                },
                error: function (xhr, status, error) {
                    showError('Error loading leaderboard: ' + error);
                },
                complete: function () {
                    $('#loading').addClass('d-none');
                }
            });
        }

        function displayLeaderboard(data) {
            const tbody = $('#leaderboard-body');
            tbody.empty();

            if (data.length === 0) {
                tbody.append('<tr><td colspan="4" class="text-center py-4">No leaderboard data available</td></tr>');
            } else {
                data.forEach((user, index) => {
                    const rank = index + 1;
                    const medal = getRankMedal(rank);
                    const premiumBadge = user.isPaidUser 
                        ? '<span class="badge bg-warning text-dark">★</span>' 
                        : '';
                    
                    const row = `
                        <tr class="${rank <= 3 ? 'table-warning' : ''}">
                            <td class="fw-bold">${medal} ${rank}</td>
                            <td>${escapeHtml(user.username)}</td>
                            <td>${user.completionTime.toFixed(2)}s</td>
                            <td class="text-center">${premiumBadge}</td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            }

            $('#leaderboard-container').removeClass('d-none');
        }

        function getRankMedal(rank) {
            switch (rank) {
                case 1: return '🥇';
                case 2: return '🥈';
                case 3: return '🥉';
                default: return '';
            }
        }

        function showError(message) {
            $('#error').text(message).removeClass('d-none');
            $('#leaderboard-container').addClass('d-none');
        }

        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, m => map[m]);
        }
    </script>
}
